<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>SSE Symfony Chat</title>
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <div id="sidebar">
            <button id="new-chat-btn">New Chat</button>
            <div id="chat-list"></div>
        </div>
        
        <div id="main-chat">
            <h2 id="current-chat-title">Choose / Create chat</h2>
            <div id="messages"></div>

            <form action="" id="chat-form">
                <input type="text" id="author" placeholder="Your name" required style="padding: 8px; width: 150px;">
                <input type="text" id="content" placeholder="Enter the message" required style="padding: 8px; flex-grow: 1;" autocomplete="off">
                <button type="submit" style="padding: 8px 15px;">Send!</button>
            </form>
        </div>

        <script>
            let currentConversationId = null;
            const chatListDiv = document.getElementById('chat-list');
            const messagesDiv = document.getElementById('messages');
            const form = document.getElementById('chat-form');
            const authorInput = document.getElementById('author');
            const contentInput = document.getElementById('content');
            const currentTitleHeader = document.getElementById('current-chat-title');
            
            const renderedMessageIds = new Set();

            async function loadConversations()
            {
                const res = await fetch('/conversations');
                const chats = await res.json();
                
                chatListDiv.innerHTML = '';
                chats.forEach(chat => {
                    const item = document.createElement('div');
                    item.className = 'chat-item' + (chat.id === currentConversationId ? 'active' : '');

                    const titleSpan = document.createElement('span');
                    titleSpan.textContent = chat.title + " ";
                    titleSpan.onclick = () => selectConversation(chat.id, chat.title);
                    item.appendChild(titleSpan);

                    const deleteBtn = document.createElement('button');
                    deleteBtn.className = 'delete-btn';
                    deleteBtn.textContent = "❌";
                    deleteBtn.onclick = (e) => {
                        e.stopPropagation();
                        if(confirm('Are you sure to delete this conversation ?'))
                            deleteConversation(chat.id);
                    };
                    
                    item.appendChild(deleteBtn);
                    chatListDiv.appendChild(item);
                });
            }

            async function selectConversation(id, title)
            {
                currentConversationId = id;
                currentTitleHeader.textContent = title;
                renderedMessageIds.clear();
                loadConversations();
                
                const res = await fetch(`/conversations/${id}/messages`);
                const messages = await res.json();

                messagesDiv.innerHTML = '';
                messages.forEach(msg =>renderMessage(msg));
            }

            function deleteConversation(conversationId)
            {
                fetch(`/conversations/${conversationId}`, {
                    method: 'DELETE'
                })
                .then(response => response.json())
                .then(data => {
                    if(data.status === 'deleted')
                    {
                        console.log('Deleted conversation ID:', data.id);
                        if(currentConversationId === conversationId)
                        {
                            currentConversationId = null;
                            messagesDiv.innerHTML = '';
                            currentTitleHeader.textContent = 'Choose the chat';
                        }
                        loadConversations();
                    }
                });
            }

            document.getElementById('new-chat-btn').addEventListener('click', async () => {
                const res = await fetch('/conversations/new', {method: 'POST'});
                const chat = await res.json();

                authorInput.disabled = false;
                selectConversation(chat.id, chat.title);
            });

            function renderMessage(msg)
            {
                if(msg.id && renderedMessageIds.has(msg.id))
                    return;
                
                if(msg.id)
                    renderedMessageIds.add(msg.id);

                const msgDiv = document.createElement('div');
                msgDiv.className = 'msg';
                msgDiv.innerHTML = `<span class="msg-time">[${msg.time}]</span> <strong>${msg.author}:</strong> ${msg.content}`;
                messagesDiv.appendChild(msgDiv);
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
            }

            form.addEventListener('submit', async (e) => {
                e.preventDefault();

                if(!currentConversationId)
                {
                    alert('Create new chat!');
                    return;
                }

                const formData = new FormData();
                formData.append('conversation_id', currentConversationId);
                formData.append('author', authorInput.value);
                formData.append('content', contentInput.value);

                const res = await fetch('/send', {method: 'POST', body: formData});
                const data = await res.json();

                if(data.status === 'sent')
                {
                    authorInput.disabled = true;
                    contentInput.value = '';

                    if(data.conversationTitle)
                        currentTitleHeader.textContent = data.conversationTitle;
                    loadConversations();
                }
            });

            const eventSource = new EventSource('/stream');
            eventSource.onmessage = function(event)
            {
                const data = JSON.parse(event.data);

                if(data.action === 'clear')
                {
                    messagesDiv.innerHTML = '';
                    renderedMessageIds.clear();
                    return;
                }

                if(data.conversation_id === currentConversationId)
                    renderMessage(data);
            };

            loadConversations();
        </script>
    </body>
</html>