<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <title>SSE Symfony Chat</title>
    </head>
    <body style="font-family: sans-serif; padding: 20px;">
        <h1>Chat (Symfony + SSE)</h1>
        
        <div id="messages" style="border: 1px solid #ccc; height: 350px; overflow-y: scroll; padding: 15px; background: #f9f9f9;">
            <!-- messages -->
        </div>

        <form id="chat-form" style="margin-top: 15px; display: flex; gap: 10px;">
            <button id="new-chat" type="button" style="padding: 5px 10px; background-color: #17a2b8; color: white; border: none; cursor: pointer;">
                New chat!
            </button>
            <input type="text" id="author" placeholder="Your name" required style="padding: 8px; width: 150px;">
            <input type="text" id="content" placeholder="Enter the message" required style="padding: 8px; flex-grow: 1;" autocomplete="off">
            <button type="submit" style="padding: 8px 15px;">Send!</button>
            <div style="display: flex; gap: 10px;">
                <button id="clear-local" type="button" style="padding: 5px 10px; background-color: #6c757d; color: white; border: none; cursor: pointer;">
                    Clear locally
                </button>
                <button id="clear-global" type="button" style="padding: 5px 10px; background-color: #dc3545; color: white; border: none; cursor: pointer;">
                    Clear globally
                </button>
            </div>
        </form>

        <script>
            const messagesDiv = document.getElementById('messages');
            const form = document.getElementById('chat-form');
            const authorInput = document.getElementById('author');
            const contentInput = document.getElementById('content');
            
            const displayedIds = new Set();
            let minVisibleId = 0;

            const eventSource = new EventSource('/stream');
            eventSource.onmessage = function(event)
            {
                const data = JSON.parse(event.data);
                
                if(data.action === 'clear')
                {
                    messagesDiv.innerHTML = '';
                    displayedIds.clear();
                    minVisibleId = 0;
                    return;
                }

                if(data.id <= minVisibleId)
                    return;

                if(displayedIds.has(data.id))
                    return;
                displayedIds.add(data.id);

                const msgElement = document.createElement('div');
                msgElement.style.marginBottom = '10px';

                //XSS
                const timeSpan = document.createElement('span');
                timeSpan.style.color = '#888';
                timeSpan.textContent = `[${data.time}]`;

                const authorStrong = document.createElement('strong');
                authorStrong.textContent = ` ${data.author}: `;

                const contentText = document.createTextNode(data.content);

                msgElement.appendChild(timeSpan);
                msgElement.appendChild(authorStrong);
                msgElement.appendChild(contentText);

                messagesDiv.appendChild(msgElement);
                messagesDiv.scrollTop = messagesDiv.scrollHeight;
            };

            form.addEventListener('submit', function(e)
            {
                e.preventDefault();

                const formData = new FormData();
                formData.append('author', authorInput.value);
                formData.append('content', contentInput.value);

                fetch('/send',
                {
                    method: 'POST',
                    body: formData
                });
                
                authorInput.disabled = true;
                contentInput.value = '';
            });

            document.getElementById('new-chat').addEventListener('click', function() {
                
                if(displayedIds.size >0)
                    minVisibleId = Math.max(...displayedIds);
                
                authorInput.disabled = false;
                authorInput.value = '';
                authorInput.focus();

                messagesDiv.innerHTML = '';
                displayedIds.clear();
            });

            document.getElementById('clear-local').addEventListener('click', function() {
                if(displayedIds.size > 0)
                {
                    minVisibleId = Math.max(...displayedIds);
                }
                messagesDiv.innerHTML = '';
                displayedIds.clear();
            });

            document.getElementById('clear-global').addEventListener('click', function() {
                if(confirm('Are you sure to TRUNCATE the table?'))
                {
                    fetch('/clear', {method: 'DELETE'})
                        .then(response => response.json())
                        .then(data => {
                            if(data.status === 'ok')
                            {
                                messagesDiv.innerHTML = '';
                                displayedIds.clear();
                                minVisibleId = 0;
                            }
                        });
                }
            });
        </script>
    </body>
</html>